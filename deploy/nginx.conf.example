# Example nginx config for QAbench human-verify-web.
#
#   /srv/x_to_skills/QAbench/human_verify_web/
#   ├── frontend/            ← nginx `root`
#   │   └── data -> ../data  ← symlink exposes JSON products
#   └── backend/             ← uvicorn upstream
#
# Copy to /etc/nginx/sites-available/qabench and symlink to sites-enabled.
# Fill in server_name and TLS certs.

upstream qabench_backend {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    listen 80;
    server_name qabench.example.org;
    # Redirect everything to HTTPS. Comment out while testing without certs.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name qabench.example.org;

    ssl_certificate     /etc/letsencrypt/live/qabench.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qabench.example.org/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    # Alpine needs 'unsafe-eval' for its expression evaluator.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';" always;

    root /srv/x_to_skills/QAbench/human_verify_web/frontend;
    index index.html;

    # Discourage LLM crawlers from eating the hard-question benchmark.
    location = /robots.txt { return 200 "User-agent: *\nDisallow: /hard.html\nDisallow: /data/\nDisallow: /api/\n"; }

    # Static site + JSON data (data is a symlink into ../data).
    location / {
        try_files $uri $uri/ =404;
    }

    # Backend
    location /api/ {
        proxy_pass         http://qabench_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    15s;

        # extra rate shield in front of slowapi, keyed per real client IP
        limit_req zone=qabench_api burst=20 nodelay;
    }
}

# place in nginx.conf (http { ... }) once:
#   limit_req_zone $binary_remote_addr zone=qabench_api:10m rate=60r/m;
